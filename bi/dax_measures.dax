// ===== Paste each measure with: Home > New measure (select the fact_311_requests table first) =====

Total Requests = SUM ( fact_311_requests[request_count] )

Resolved Requests =
CALCULATE ( [Total Requests], fact_311_requests[is_resolved] = TRUE () )

Open Requests =
CALCULATE ( [Total Requests], fact_311_requests[is_resolved] = FALSE () )

Resolution Rate % = DIVIDE ( [Resolved Requests], [Total Requests] )

Avg Resolution Hours = AVERAGE ( fact_311_requests[resolution_hours] )

Avg Resolution Days = DIVIDE ( [Avg Resolution Hours], 24 )

Rodent Requests =
CALCULATE ( [Total Requests], dim_complaint_type[complaint_group] = "Rodent" )

// Uses the inactive relationship fact[closed_date_key] -> dim_time[date_key]
Requests Closed On Date =
CALCULATE (
    [Total Requests],
    USERELATIONSHIP ( fact_311_requests[closed_date_key], dim_time[date_key] ),
    fact_311_requests[is_resolved] = TRUE ()
)

// ===== Audit and error logging (select the vw_pipeline_runs table first) =====

Pipeline Runs = COUNTROWS ( vw_pipeline_runs )

Failed Runs =
CALCULATE ( COUNTROWS ( vw_pipeline_runs ), vw_pipeline_runs[status] = "Failure" )

Pipeline Success Rate % =
DIVIDE (
    CALCULATE ( COUNTROWS ( vw_pipeline_runs ), vw_pipeline_runs[status] = "Success" ),
    COUNTROWS ( vw_pipeline_runs )
)

Avg Run Seconds = AVERAGE ( vw_pipeline_runs[duration_seconds] )

Last Pipeline Run = MAX ( vw_pipeline_runs[end_time] )

// select the vw_quarantine_summary table first
Quarantined Rows = SUM ( vw_quarantine_summary[quarantined_rows] )
